# ==============================================================================
# MultiSense Environment Variables & Database Configuration (Template)
# ==============================================================================

# Paste your MongoDB Atlas URI here:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Target Database and Collection
MONGODB_DB_NAME=multisense_db
MONGODB_COLLECTION=sensor_telemetry

# Server Configuration
PORT=8000
HOST=0.0.0.0
